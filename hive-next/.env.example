# Copy to .env.local for local development. Never commit real secrets.

# Auth cutover is explicit. Keep "supabase" until Clerk + DB bridge are fully verified.
HIVE_AUTH_PROVIDER=supabase

# Clerk keys. Adding these alone does NOT switch Hive to Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# Supabase database. Use only the public/publishable client key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never expose service-role keys to browser code.

# Clerk only: keep false until the identity bridge, identity mapping and
# Clerk/Supabase Third-Party Auth integration are verified.
HIVE_CLERK_DB_BRIDGE_ENABLED=false

# Show the one-time legacy -> Clerk migration code UI only after the
# 20261016 identity-link migration is applied and reviewed.
HIVE_IDENTITY_MIGRATION_ENABLED=false

# Outbound email remains blocked unless this is explicitly enabled server-side.
HIVE_ENABLE_EMAIL_SEND=false

# Preview workspace allowlist, in addition to member-owned hive-dev-* workspaces.
HIVE_DEV_WORKSPACE_IDS=
